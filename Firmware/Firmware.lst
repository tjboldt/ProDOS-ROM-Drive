000000r 1               ;i/o ports to write to
000000r 1                 writeIoPortHigh = $C081
000000r 1                 writeIoPortLow  = $C080
000000r 1               
000000r 1               ;ProDOS defines
000000r 1                 command = $42   ;ProDOS command
000000r 1                 unit  = $43  ;7=drive 6-4=slot 3-0=not used
000000r 1                 buflo = $44  ;low address of buffer
000000r 1                 bufhi = $45  ;hi address of buffer
000000r 1                 blklo = $46  ;low block #
000000r 1                 blkhi = $47  ;hi block #
000000r 1                 badcmd = $01 ;invalid command
000000r 1                 ioerr = $27  ;I/O error code
000000r 1                 nodev = $28  ;no device connected
000000r 1                 wperr = $2B  ;write protect error
000000r 1               
000000r 1               ;for relocatable code
000000r 1                 ioAddressLo   = $FA
000000r 1                 ioAddressHi   = $FB
000000r 1                 tempY = $FC
000000r 1                 blockHalfCounter = $FD
000000r 1                 lowLatch = $FE
000000r 1                 highLatch = $FF
000000r 1               
000000r 1                 knownRts   = $FF58
000000r 1               
000000r 1               ;autostart ROM next card
000000r 1                 sloop = $FABA
000000r 1                 keyboard = $C000
000000r 1                 clearKeyboard = $C010
000000r 1               
000000r 1                 .org  $C700
00C700  1                 ;code is relocatable
00C700  1                 ; but set to $c700 for
00C700  1                 ; readability in assembly listing
00C700  1               
00C700  1               ;ID bytes for booting and drive detection
00C700  1  E0 20          cpx  #$20    ;ID bytes for ProDOS and the
00C702  1  A0 00          ldy  #$00    ; Apple Autostart ROM
00C704  1  E0 03          cpx  #$03    ;
00C706  1  E0 3C          cpx  #$3C    ;this one for older II's
00C708  1               
00C708  1               ;check for ESC key and if so, jump to next slot in autostart
00C708  1  AD 00 C0       lda keyboard
00C70B  1  C9 9B          cmp #$9B
00C70D  1  D0 03          bne start
00C70F  1  4C BA FA       jmp sloop
00C712  1               
00C712  1               ;zero out block numbers and buffer address
00C712  1               start:
00C712  1  84 44          sty  buflo
00C714  1  84 46          sty  blklo
00C716  1  84 47          sty  blkhi
00C718  1  C8             iny		;set command = 1 for read block
00C719  1  84 42          sty  command
00C71B  1  20 58 FF       jsr  knownRts ;jump to known RTS to get our address from the stack
00C71E  1  BA             tsx
00C71F  1  BD 00 01       lda  $0100,x ;this for example would be $C7 in slot 7
00C722  1  85 45          sta  bufhi   ;keep the slot here
00C724  1  0A             asl
00C725  1  0A             asl
00C726  1  0A             asl
00C727  1  0A             asl
00C728  1  85 43          sta unit
00C72A  1               
00C72A  1               ;display copyright message
00C72A  1  A0 CE          ldy  #<text
00C72C  1               drawtxt:
00C72C  1  B1 44          lda  (buflo),y
00C72E  1  F0 06          beq  boot
00C730  1  99 02 07       sta  $07D0-<text,y ;put text on last line
00C733  1  C8             iny
00C734  1  D0 F6          bne  drawtxt
00C736  1               
00C736  1               ;load block 0000 at $0800
00C736  1               boot:
00C736  1  A9 08          lda  #$08 ;push $0800 onto the stack so an RTS will run at $0801
00C738  1  85 45          sta  bufhi
00C73A  1  48             pha
00C73B  1  A9 00          lda #$00
00C73D  1  48             pha
00C73E  1               ;This is the ProDOS entry point for this card
00C73E  1               entry:
00C73E  1  A6 43          ldx  unit  ;make sure it's drive 1 (bit 7 is clear; bit 7 set would mean drive 2)
00C740  1  10 04          bpl  docmd ;yep, do command
00C742  1  38             sec				 ;nope, set device not connected
00C743  1  A9 28          lda  #nodev
00C745  1  60             rts        ;go back to ProDOS
00C746  1               
00C746  1               docmd:
00C746  1  A5 42          lda  command
00C748  1  F0 0E          beq  getstat ;command 0 is GetStatus
00C74A  1  C9 01          cmp  #$01
00C74C  1  F0 12          beq  readblk ;command 1 is ReadBlock
00C74E  1  C9 04          cmp  #$04    ;command 2 is WriteBlock, command 3 is Format, >=4 are undefined
00C750  1  A9 2B          lda  #wperr  ;write protect error (lda preserves carry from the cmp)
00C752  1  90 02          bcc  senderr ;commands 2 and 3 are valid but not permitted
00C754  1  A9 01          lda  #badcmd ;anything higher is not a command at all
00C756  1               senderr:
00C756  1  38             sec          ;flag the error for ProDOS
00C757  1  60             rts          ;go back to ProDOS
00C758  1               
00C758  1               getstat:
00C758  1  18             clc       ;send back status
00C759  1  A9 00          lda  #$00 ;good status
00C75B  1  A2 00          ldx  #$00 ;2048 blocks
00C75D  1  A0 08          ldy  #$08 ;
00C75F  1  60             rts
00C760  1               
00C760  1               readblk:
00C760  1               saveVars:  ;stash zero page space - we replace it on exit
00C760  1  A0 FA          ldy #ioAddressLo
00C762  1               varLoop:
00C762  1  B9 00 00       lda $00,y
00C765  1  48             pha
00C766  1  C8             iny
00C767  1  D0 F9          bne varLoop
00C769  1               
00C769  1  A5 47          lda  blkhi    ;get MSB of requested block number
00C76B  1  0A             asl  a    ;shift up to top 3 bits
00C76C  1  0A             asl  a    ;since that's all the high
00C76D  1  0A             asl  a    ;blocks we can handle (i.e. 0x07ff)
00C76E  1  0A             asl  a    ;
00C76F  1  0A             asl  a    ;
00C770  1  85 FF          sta  highLatch
00C772  1  A5 46          lda  blklo   ;get LSB of requested block number
00C774  1  4A             lsr  a    ;shift so we get the top 5
00C775  1  4A             lsr  a    ;bits - this also goes in
00C776  1  4A             lsr  a    ;the high latch
00C777  1  05 FF          ora  highLatch ;add it to those top 3 bits
00C779  1  85 FF          sta  highLatch ;save it back in scratch ram
00C77B  1  9D 81 C0       sta  writeIoPortHigh,x	;set high latch for card - x is still set to unit number
00C77E  1  A5 46          lda  blklo   ;get LSB of requested block number (to get the bottom 3 bits this time)
00C780  1  0A             asl  a    ;shift it to top 3 bits
00C781  1  0A             asl  a    ;
00C782  1  0A             asl  a    ;
00C783  1  0A             asl  a    ;
00C784  1  0A             asl  a    ;
00C785  1  85 FE          sta lowLatch ;save it back in scratch ram
00C787  1  A9 02          lda  #$02
00C789  1  85 FD          sta  blockHalfCounter
00C78B  1  A9 C0          lda #$C0
00C78D  1  85 FB          sta ioAddressHi ;MSB of I/O address pointer - we access them 16 at a time
00C78F  1               
00C78F  1               ;This gets 256 bytes from the ROM card
00C78F  1               
00C78F  1               read256:
00C78F  1  A0 00          ldy  #$00
00C791  1               loop256:
00C791  1  A5 FE          lda  lowLatch
00C793  1  9D 80 C0       sta  writeIoPortLow,x ; x (still) holds unit number
00C796  1  8A             txa
00C797  1  09 80          ora  #$80
00C799  1  85 FA          sta  ioAddressLo ;LSB of I/O address pointer - now points to the correct slot
00C79B  1               
00C79B  1               loop16:
00C79B  1  84 FC          sty  tempY
00C79D  1  A0 00          ldy  #$00
00C79F  1  B1 FA          lda  (ioAddressLo),y ;pull a value from card indexed by y
00C7A1  1  A4 FC          ldy  tempY
00C7A3  1  91 44          sta  (buflo),y       ;save that same value to the output buffer also indexed by y
00C7A5  1  C8             iny
00C7A6  1  E6 FA          inc  ioAddressLo
00C7A8  1  A5 FA          lda  ioAddressLo
00C7AA  1  29 0F          and  #$0F            ;mod 16, we will roll through this 16 times due to the outer loop256
00C7AC  1  D0 ED          bne  loop16
00C7AE  1               
00C7AE  1               continue256:
00C7AE  1  E6 FE          inc  lowLatch        ;point at the next batch of 16
00C7B0  1  C0 00          cpy  #$00            ;did we complete 256?
00C7B2  1  D0 DD          bne  loop256         ;no - loop around
00C7B4  1  C6 FD          dec  blockHalfCounter
00C7B6  1  D0 11          bne  readnext256     ;did we do 256 twice?  if no - bump the MSB of buffer and loop back around
00C7B8  1               
00C7B8  1               restoreVars:  ;restore zero page space we saved when initially called
00C7B8  1  A0 FF          ldy #highLatch
00C7BA  1               restoreLoop:
00C7BA  1  68             pla
00C7BB  1  99 00 00       sta $00,y
00C7BE  1  88             dey
00C7BF  1  C0 F9          cpy #ioAddressLo - 1
00C7C1  1  D0 F7          bne restoreLoop
00C7C3  1               
00C7C3  1  C6 45          dec  bufhi
00C7C5  1  18             clc       ;clear error code for success
00C7C6  1  A9 00          lda  #$00
00C7C8  1  60             rts
00C7C9  1               
00C7C9  1               readnext256:
00C7C9  1  E6 45          inc  bufhi   ; set buffer to receive next 256 bytes
00C7CB  1  18             clc          ; effectively a branch always
00C7CC  1  90 C1          bcc  read256
